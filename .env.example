# Copy to .env and fill in. NEVER commit .env.

# --- Database ---------------------------------------------------------------
# Docker Compose sets DATABASE_URL itself from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me-too
# Local development without Docker: leave empty to use the embedded dev DB (backend/dev_db.py),
# or point at your own PostgreSQL 14+:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mediamonitor
DATABASE_URL=

# --- Admin login (the whole app is login-gated) -------------------------------
ADMIN_USERNAME=admin
# Generate the hash (prompts for the password, writes this file):  python backend/set_admin_password.py
# or by hand:  python -c "import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt()).decode())"
# NOTE: wrap the hash in SINGLE quotes (it contains "$"): ADMIN_PASSWORD_HASH='$2b$12$...'
ADMIN_PASSWORD_HASH=
# Long random string used to sign login cookies:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# --- AI provider for press briefs (Phase 5; not used yet) ----------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Crawler ----------------------------------------------------------------
# Identify yourself honestly so site owners can contact you.
CRAWLER_USER_AGENT=MediaMonitorBot/0.1 (+contact: set-your-contact)
